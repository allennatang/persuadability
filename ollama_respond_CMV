def pull_model():
    """Pull the specified ollama model"""
        try:
            subprocess.run(["ollama", "pull", model], check=True)
        except subprocess.CalledProcessError as e:
            print(f"Error pulling model {model}: {e}")

def get_LLM_delta_response(system_prompt, user_prompt):
    global model
    global temperature

    response = ollama.generate(
        model=model, 
        prompt=system_prompt, 
        system=system_prompt, 
        options={'temperature': temperature}
        )
    return response['response']

def get_results(sample):
    global template_system
    global template_user
    counter = 0
    start_time = time.time() # Record the start time
    print('STARTED')

    for index, row in sample.iterrows():
        counter += 1
        if counter % 100 == 0:
            elapsed_time = time.time() - start_time # Calculate elapsed time
            print(f"Processed {counter} / {len(sample)} samples. Time elapsed: {elapsed_time:.2f} seconds.")

        title_OP = row['title_OP']
        text_OP = row['text_OP']
        text_replyto = row['text_replyto']
    
        system_prompt = template_system.format(title_OP=title_OP, text_OP=text_OP)
        user_prompt = template_user.format(text_replyto=text_replyto)

        # Escape characters in the LLM-generated response so it doesn't break the csv file
        try:
            response_LLM = get_LLM_delta_response(system_prompt, user_prompt)
            sample.at[index, 'Response_LLM'] = repr(response_LLM)  # wraps in quotes and escapes special chars
        except Exception as e:
            sample.at[index, 'Response_LLM'] = f"Error: {str(e)}"

        export_file_name = f'results_{model}.csv'
        export_file_name = export_file_name.replace(':', '_') # so that it doesn't break when it gets downloaded
        sample.to_csv(export_file_name, index=False)

    return export_file_name

def safe_export(df: pd.DataFrame, filename: str) -> None:
    """Safely export DataFrame to CSV with proper escaping."""
    try:
        # Ensure filename is safe
        safe_filename = filename.replace(':', '_').replace('/', '_')
        df.to_csv(safe_filename, index=False, escapechar='\\', quoting=1)
        print(f"Successfully saved to {safe_filename}")
    except Exception as e:
        print(f"Error saving file {filename}: {e}")
        raise

